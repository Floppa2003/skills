+rm -f /logs/verifier/reward.txt
+rc=0
+python3 /tests/verify.py || rc=$?
+case "$rc" in
+  0) echo 1 > /logs/verifier/reward.txt ;;
+  10) echo 0 > /logs/verifier/reward.txt ;;
+  *) echo "VERIFIER_ERROR: exit $rc" >&2; exit "$rc" ;;
+esac
